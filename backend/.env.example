PORT=5010
MONGODB_URI=mongodb://127.0.0.1:27017/ghanatech_global
JWT_SECRET=super_secret_jwt_key_change_in_production_9f83a21b4
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
UPLOAD_DIR=uploads
NODE_ENV=development

# Local disk for development. Set blob on Vercel.
CV_STORAGE=local
# Connect a PRIVATE Blob store to your Vercel project; its token stays server-side.
BLOB_READ_WRITE_TOKEN=

# Only needed locally for the one-time create-admin command.
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=
ADMIN_INITIAL_NAME=GhanaTech Administrator

# Transactional email: keep disabled until you configure a verified sender.
EMAIL_DELIVERY_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
# Public canonical domain and the secret used by the scheduled communications endpoint.
SITE_URL=http://localhost:5174
CRON_SECRET=
